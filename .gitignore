# Local agent plans and handoffs. Not part of the program.
/agents/

# Cargo. `target` also covers spike/target and target/dx.
target
debug
**/*.rs.bk
*.pdb
**/mutants.out*/

# dx bundle output. Android Gradle output stays under target/dx.
/dist/

# nix build symlinks. flake.lock stays tracked.
/result
/result-*

# Tool caches. devbox.json and .envrc stay tracked.
.devbox/
.direnv/
.process-compose/

# Signing material and local env. The release keystore lives in CI secrets.
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
keystore.properties
local.properties

# Packages copied out of target/.
*.apk
*.aab

# Editor and OS leftovers.
.idea/
*.swp
*~
.DS_Store
